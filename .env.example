# ==============================================================================
# Obesity Management System – Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/obesity_management_db?retryWrites=true&w=majority

# Authentication (JWT Secret Key)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Machine Learning Microservice Connection
# In Docker Compose, use container DNS: http://ml-service:5001
# In Local Development, use localhost: http://localhost:5001
ML_SERVICE_URL=http://ml-service:5001
ML_PORT=5001

# Frontend Configuration
# URL of the Backend API as accessed by the user's browser
VITE_API_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:3000

# Email Service (Optional for Doctor Welcome Credentials)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="ObesityCare Admin" <noreply@obesitycare.hospital.lk>
