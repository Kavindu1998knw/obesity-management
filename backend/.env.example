# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/obesity_management_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ML Microservice Endpoint
ML_SERVICE_URL=http://localhost:5001

# Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Optional Email Configuration (Nodemailer)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM="ObesityCare Admin" <noreply@obesitycare.hospital.lk>
